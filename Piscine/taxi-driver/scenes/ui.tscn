[sub_resource type="GDScript" id="GDScript_wm3ai"]
script/source = "extends NinePatchRect

@onready var meter_label: Label = $meters

func _ready() -> void:
	update_label(0.0)

func update_label(distance: float) -> void:
	# Display distance rounded to 1 decimal, in meters for example
	meter_label.text = \"Distance: %.1f m\" % distance
"

